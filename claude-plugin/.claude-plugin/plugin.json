{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "skillroute",
  "displayName": "SkillRoute by JEStats",
  "version": "0.6.0",
  "description": "Find the right skills for your next task. SkillRoute indexes your local SKILL.md library and returns ranked matches with confidence, reasons, and source evidence.",
  "author": {
    "name": "JEStats",
    "url": "https://jestats.io"
  },
  "homepage": "https://github.com/jestatsio/skillroute",
  "repository": "https://github.com/jestatsio/skillroute",
  "documentationUrl": "https://github.com/jestatsio/skillroute/tree/main/claude-plugin#readme",
  "supportUrl": "https://github.com/jestatsio/skillroute/issues",
  "privacyPolicyUrl": "https://github.com/jestatsio/skillroute/tree/main/claude-plugin#privacy",
  "license": "MIT",
  "keywords": [
    "skills",
    "agent-skills",
    "skill-routing",
    "skill-catalog",
    "mcp",
    "retrieval"
  ],
  "mcpServers": {
    "skillroute": {
      "command": "npx",
      "args": [
        "-y",
        "@skillroute/mcp-server@0.6.0"
      ]
    }
  },
  "icon": ".claude-plugin/icon.svg"
}
